# Database
# NeonDB PostgreSQL connection string (with connection pooling for serverless)
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&connection_limit=1&pool_timeout=0
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&connection_limit=1&pool_timeout=0"

# Admin Authentication
# Generate a strong random password for production
# You can use: openssl rand -base64 32
ADMIN_PASSWORD="your-super-secure-random-password-here"

# App URL (for production, set to your Vercel URL)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"